    {
      "name": "02 - HU-17 Registrar cambio de estado",
      "description": "POST /traces (CLIENTE o EMPLEADO). Normalmente lo llama plazoleta en cada cambio de estado; aqui se prueba directamente. Usa un id de pedido de prueba (manualOrderId) para no mezclarlo con el pedido real.",
      "item": [
        {
          "name": "CLIENTE registra un cambio de su pedido (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/traces",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "traces"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{manualOrderId}},\n  \"clientId\": {{clientId}},\n  \"restaurantId\": {{restaurantId}},\n  \"employeeId\": null,\n  \"previousStatus\": null,\n  \"newStatus\": \"PENDIENTE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"manualOrderId\", 900000000 + Math.floor(Math.random() * 99999999));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Devuelve el registro con id y fecha\", () => {",
                  "    pm.expect(body.id).to.be.a(\"string\");",
                  "    pm.expect(body.date).to.be.a(\"string\");",
                  "    pm.expect(body.newStatus).to.eql(\"PENDIENTE\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EMPLEADO del restaurante registra un cambio (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
