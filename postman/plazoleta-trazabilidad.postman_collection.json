    {
      "name": "01 - HU-17 Consultar trazabilidad",
      "description": "GET /traces/orders/{id} (solo CLIENTE): el cliente consulta el historial de cambios de estado de SUS pedidos.",
      "item": [
        {
          "name": "Historial de mi pedido (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/traces/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "traces",
                "orders",
                "{{orderId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const traces = pm.response.json();",
                  "pm.test(\"El primer registro es la creacion del pedido (sin estado anterior -> PENDIENTE)\", () => {",
                  "    pm.expect(traces[0].previousStatus).to.eql(null);",
                  "    pm.expect(traces[0].newStatus).to.eql(\"PENDIENTE\");",
                  "});",
                  "pm.test(\"Cada cambio parte del estado anterior y van del mas antiguo al mas reciente\", () => {",
                  "    for (let i = 1; i < traces.length; i++) {",
                  "        pm.expect(traces[i].previousStatus).to.eql(traces[i - 1].newStatus);",
                  "        pm.expect(new Date(traces[i].date) >= new Date(traces[i - 1].date)).to.eql(true);",
                  "    }",
                  "});",
                  "pm.test(\"Registra la creacion y la asignacion del pedido\", () => {",
                  "    pm.expect(traces.length).to.eql(2);",
                  "    pm.expect(traces[1].previousStatus).to.eql(\"PENDIENTE\");",
                  "    pm.expect(traces[1].newStatus).to.eql(\"EN_PREPARACION\");",
                  "    pm.expect(traces[1].employeeId).to.not.eql(null);",
                  "});",
                  "pm.test(\"Cada registro trae pedido, cliente, restaurante y fecha\", () => {",
                  "    traces.forEach((t) => {",
                  "        pm.expect(t.orderId).to.eql(Number(pm.collectionVariables.get(\"orderId\")));",
                  "        pm.expect(t.clientId).to.eql(Number(pm.collectionVariables.get(\"clientId\")));",
                  "        pm.expect(t.restaurantId).to.eql(Number(pm.collectionVariables.get(\"restaurantId\")));",
                  "        pm.expect(t.date).to.be.a(\"string\");",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
