            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{manualOrderId}},\n  \"clientId\": {{clientId}},\n  \"restaurantId\": {{restaurantId}},\n  \"employeeId\": null,\n  \"previousStatus\": \"PENDIENTE\",\n  \"newStatus\": \"EN_PREPARACION\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
