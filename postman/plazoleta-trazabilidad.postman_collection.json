              }
            }
          ]
        },
        {
          "name": "El cliente ve ese historial (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/traces/orders/{{manualOrderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "traces",
                "orders",
                "{{manualOrderId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const traces = pm.response.json();",
                  "pm.test(\"El primer registro es la creacion del pedido (sin estado anterior -> PENDIENTE)\", () => {",
                  "    pm.expect(traces[0].previousStatus).to.eql(null);",
                  "    pm.expect(traces[0].newStatus).to.eql(\"PENDIENTE\");",
                  "});",
                  "pm.test(\"Cada cambio parte del estado anterior y van del mas antiguo al mas reciente\", () => {",
                  "    for (let i = 1; i < traces.length; i++) {",
                  "        pm.expect(traces[i].previousStatus).to.eql(traces[i - 1].newStatus);",
                  "        pm.expect(new Date(traces[i].date) >= new Date(traces[i - 1].date)).to.eql(true);",
                  "    }",
                  "});",
                  "pm.test(\"Tiene los dos registros\", () => pm.expect(traces.length).to.eql(2));"
                ]
              }
            }
          ]
        },
